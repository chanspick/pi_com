# 카카오페이 API 설정
# https://developers.kakaopay.com/ 에서 발급받으세요

# 카카오페이 Admin Key (Secret Key)
KAKAO_ADMIN_KEY=your_admin_key_here

# 카카오페이 가맹점 코드
# 테스트 환경: TC0ONETIME
# 프로덕션: 발급받은 CID
KAKAO_CID=TC0ONETIME

# =============================================================================
# 토스페이먼츠 API 설정
# https://developers.tosspayments.com/ 에서 발급받으세요
# =============================================================================

# 토스페이먼츠 Client Key (결제위젯 초기화용)
# 테스트: test_ck_... / 프로덕션: live_ck_...
TOSS_CLIENT_KEY=test_ck_your_client_key_here

# 토스페이먼츠 Secret Key (서버 인증용)
# 테스트: test_sk_... / 프로덕션: live_sk_...
TOSS_SECRET_KEY=test_sk_your_secret_key_here

# 서버 포트
PORT=3000

# 앱 스킴 (Deep Link)
APP_SCHEME=picom://payment
