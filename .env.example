# PiCom 환경 변수 예시
# 이 파일을 .env로 복사해서 사용하세요: cp .env.example .env

# === 현재 사용 중인 환경변수 ===
# (없음 - Firebase/카카오 설정은 별도 파일에서 관리됨)
#   - Firebase: lib/firebase_options.dart
#   - 카카오 SDK: lib/main.dart에 하드코딩

# === 향후 추가 예정 (선택적) ===
# KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key
# KAKAO_JS_APP_KEY=your_kakao_js_app_key
